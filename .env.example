# Copy this file to .env and replace the placeholder values.
DATABASE_URL=postgresql://mat3route:your_password@localhost:5432/mat3route_dev
PGHOST=localhost
PGPORT=5432
PGDATABASE=mat3route_dev
PGUSER=mat3route
PGPASSWORD=your_password

# OpenWeatherMap
OPENWEATHER_API_KEY=your_openweather_api_key
OPENWEATHER_CITY=Nairobi
OPENWEATHER_LATITUDE=-1.2921
OPENWEATHER_LONGITUDE=36.8219
WEATHER_POLL_MINUTES=10

# Notifications. Use "mock" locally, or "thrivewave" with an API key.
# Default provider below is ThriveVas SMS. For ThrivePush web push, set
# THRIVEWAVE_CHANNEL=push, THRIVEWAVE_BASE_URL=https://thrivepush.io and a website ID.
# Master SMS kill switch: keep false to guarantee no real SMS is sent.
SMS_ENABLED=false
NOTIFICATION_PROVIDER=mock
THRIVEWAVE_CHANNEL=sms
THRIVEWAVE_BASE_URL=https://sms.thrivevas.com
THRIVEWAVE_SMS_PATH=/v1/message/send
THRIVEWAVE_SENDER_ID=ThriveVas
THRIVEWAVE_CALLBACK_URL=
THRIVEWAVE_NOTIFICATIONS_PATH=/api/personal-notifications
THRIVEWAVE_API_KEY=
THRIVEWAVE_WEBSITE_ID=
THRIVEWAVE_DEVICE_ID=
THRIVEWAVE_SIM_SUBSCRIPTION_ID=

# Service
ADMIN_API_TOKEN=change_me
SCHEDULER_ENABLED=true
AUTO_CREATE_TABLES=true
TIMEZONE=Africa/Nairobi
CORS_ORIGINS=*
